        },
    {
        website: "https://www.researchgate.net/publication/397575508_Enhancing_Security_and_Privacy_in_Federated_Learning_for_Distributed_Systems_The_REMINDER_Approach",
        title: {
            spanish: "Paper: REMINDER",
            english: "Paper: REMINDER",
        },
        subtitle: {
            spanish: "Enhancing Security and Privacy in Federated Learning for Distributed Systems: The REMINDER Approach",
            english: "Enhancing Security and Privacy in Federated Learning for Distributed Systems: The REMINDER Approach",
        },
        period:
        {
            spanish: "2026",
            english: "2026",
        },
        description: {
            spanish: "Publicado en el Global IoT and Edge Computing Summit (GIECS 2025, Springer). Resultado del proyecto europeo CHIST-ERA REMINDER sobre aprendizaje federado que preserva la privacidad, robusto frente a ataques de envenenamiento e inferencia",
            english: "Published at the Global IoT and Edge Computing Summit (GIECS 2025, Springer). Outcome of the EU CHIST-ERA REMINDER project on privacy-preserving federated learning, robust to poisoning and inference attacks",
        },
        image: "/assets/research/reminder.png"
