---
const { currentLanguage, triggerClass = "", listAlign = "center", block = false, direction = "down" } = Astro.props;
---

<div class={`cv-menu${block ? ' cv-menu-block' : ''}`} data-cv-menu>
  <button type="button" class={`cv-menu-trigger ${triggerClass}`} aria-haspopup="true" aria-expanded="false">
    <slot />
  </button>
  <div class={`cv-menu-list align-${listAlign} direction-${direction}`} role="menu">
    <a
      href="/CV_FranCortes.pdf"
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
      class="cv-download-link"
      data-cv-variant="engineer"
    >
      {currentLanguage === 'spanish' ? 'CV Ingeniero' : 'Engineer CV'}
    </a>
    <a
      href="/CV_FranCortes_Researcher.pdf"
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
      class="cv-download-link"
      data-cv-variant="researcher"
    >
      {currentLanguage === 'spanish' ? 'CV Investigador' : 'Researcher CV'}
    </a>
    <a
      href="/CV_FranCortes_SocialMedia.pdf"
      target="_blank"
      rel="noopener noreferrer"
      role="menuitem"
      class="cv-download-link"
      data-cv-variant="social-media"
    >
      {currentLanguage === 'spanish' ? 'CV Ponente / Redes' : 'Speaker / Media CV'}
    </a>
  </div>
</div>

<script>
  const cvTriggers = new Map();

  function initCvMenus() {
    document.querySelectorAll('[data-cv-menu]').forEach((menu) => {
      if (menu.hasAttribute('data-cv-menu-ready')) return;
      menu.setAttribute('data-cv-menu-ready', 'true');

      const trigger = menu.querySelector('.cv-menu-trigger');
      const list = menu.querySelector('.cv-menu-list');
      if (!trigger || !list) return;

      // Reparent the dropdown to <body> so it always escapes ancestor
      // overflow/scroll clipping (e.g. the mobile icon row uses
      // overflow-x: auto, which was silently clipping this menu on
      // phones) and so `position: fixed` is always relative to the
      // viewport, not some transformed ancestor.
      document.body.appendChild(list);
      cvTriggers.set(list, trigger);

      const isUp = list.classList.contains('direction-up');
      const isCenter = list.classList.contains('align-center');
      const isRight = list.classList.contains('align-right');

      const position = () => {
        const rect = trigger.getBoundingClientRect();
        const listRect = list.getBoundingClientRect();
        const margin = 8;
        let left;
        if (isCenter) {
          left = rect.left + rect.width / 2 - listRect.width / 2;
        } else if (isRight) {
          left = rect.right - listRect.width;
        } else {
          left = rect.left;
        }
        left = Math.max(margin, Math.min(left, window.innerWidth - listRect.width - margin));

        if (isUp) {
          list.style.top = 'auto';
          list.style.bottom = `${window.innerHeight - rect.top + 8}px`;
        } else {
          list.style.bottom = 'auto';
          list.style.top = `${rect.bottom + 8}px`;
        }
        list.style.left = `${left}px`;
      };

      const close = () => {
        list.classList.remove('open');
        trigger.setAttribute('aria-expanded', 'false');
      };

      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        document.querySelectorAll('.cv-menu-list.open').forEach((other) => {
          if (other !== list) {
            other.classList.remove('open');
            cvTriggers.get(other)?.setAttribute('aria-expanded', 'false');
          }
        });
        const isOpen = list.classList.toggle('open');
        trigger.setAttribute('aria-expanded', String(isOpen));
        if (isOpen) position();
      });

      list.querySelectorAll('.cv-download-link').forEach((link) => {
        link.addEventListener('click', close);
      });

      window.addEventListener('resize', () => {
        if (list.classList.contains('open')) position();
      });
    });

    document.addEventListener('click', (e) => {
      document.querySelectorAll('.cv-menu-list.open').forEach((list) => {
        const trigger = cvTriggers.get(list);
        if (!list.contains(e.target) && !(trigger && trigger.contains(e.target))) {
          list.classList.remove('open');
          trigger?.setAttribute('aria-expanded', 'false');
        }
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('.cv-menu-list.open').forEach((list) => {
          list.classList.remove('open');
          cvTriggers.get(list)?.setAttribute('aria-expanded', 'false');
        });
      }
    });

    document.addEventListener('scroll', () => {
      document.querySelectorAll('.cv-menu-list.open').forEach((list) => {
        list.classList.remove('open');
        cvTriggers.get(list)?.setAttribute('aria-expanded', 'false');
      });
    }, true);
  }

  document.addEventListener('DOMContentLoaded', initCvMenus);
  initCvMenus();
</script>

<style>
  .cv-menu {
    position: relative;
    display: inline-block;
  }
  .cv-menu-block {
    display: block;
    width: 100%;
  }
  .cv-menu-trigger {
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    text-align: inherit;
    width: 100%;
    height: 100%;
  }
  .cv-menu-list {
    /* top/bottom/left are set inline by JS once reparented to <body>,
       so this always escapes ancestor overflow clipping (e.g. the
       mobile icon row) and stays viewport-relative. */
    position: fixed;
    background: var(--card-color, #1a1a1a);
    border: 1px solid var(--special-border-color, #929292);
    border-radius: 12px;
    padding: 0.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 170px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.25);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(4px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
    z-index: 1001;
  }
  .cv-menu-list.direction-up {
    transform: translateY(-4px);
  }

  .cv-menu-list.open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  .cv-menu-list a {
    padding: 0.55rem 0.85rem;
    border-radius: 8px;
    font-size: 0.85rem;
    white-space: nowrap;
    text-decoration: none;
    color: var(--text-color, #fff);
    opacity: 0.85;
    transition: background 0.15s ease, opacity 0.15s ease;
  }
  .cv-menu-list a:hover {
    background: var(--blue-titles-color, #7970e0);
    opacity: 1;
  }
</style>
